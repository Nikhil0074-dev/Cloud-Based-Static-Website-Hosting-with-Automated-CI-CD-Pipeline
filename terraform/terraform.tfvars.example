aws_region  = "ap-south-1"
bucket_name = "my-unique-static-site-bucket"
github_repo = "your-github-username/Cloud-Static-Website-CICD"

# Optional custom domain (requires an existing Route 53 hosted zone)
# domain_name       = "www.example.com"
# route53_zone_name = "example.com"

# Optional alarm notifications
# alert_email = "you@example.com"

# Set to false if this AWS account already has the GitHub OIDC provider
# create_github_oidc_provider = false
